# Database Configuration
DATABASE_URL=postgresql://citeconnect:password@127.0.0.1:5433/citeconnect
POSTGRES_USER=citeconnect
POSTGRES_PASSWORD=password
POSTGRES_DB=citeconnect
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Weaviate Configuration
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
WEAVIATE_TIMEOUT=30

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TRACK_STARTED=True
CELERY_TASK_TIME_LIMIT=3600

# JWT Configuration
SECRET_KEY=your-secret-key-min-32-characters-long-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (JSON format for Pydantic)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_METHODS=["GET","POST","PUT","DELETE","PATCH"]
ALLOWED_HEADERS=["*"]

# GCP Configuration (optional for local development)
GCP_PROJECT_ID=citeconnect-dev
GCS_BUCKET_NAME=citeconnect-papers-dev
GCP_CREDENTIALS_PATH=

# External APIs
SEMANTIC_SCHOLAR_API_KEY=
OPENAI_API_KEY=

# SPECTER Model Configuration
SPECTER_MODEL_NAME=allenai/specter
SPECTER_CACHE_DIR=./models/specter
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_SEARCH=100
RATE_LIMIT_GRAPH=50

# Cache TTL Settings (in seconds)
CACHE_TTL_USER_SESSION=86400
CACHE_TTL_STARTER_KIT=86400
CACHE_TTL_CLUSTER=3600
CACHE_TTL_GRAPH=3600
CACHE_TTL_SEARCH=1800
CACHE_TTL_PAPER_METADATA=86400
CACHE_TTL_USER_EMBEDDING=21600

# Clustering Settings
N_CLUSTERS_HOME=3
CLUSTER_MIN_PAPERS=5
CLUSTER_MAX_PAPERS=7

# Recommendation Weights
RECOMMENDATION_SEMANTIC_WEIGHT=0.35
RECOMMENDATION_CITATION_WEIGHT=0.20
RECOMMENDATION_KEYWORD_WEIGHT=0.15
RECOMMENDATION_POPULARITY_WEIGHT=0.15
RECOMMENDATION_RECENCY_WEIGHT=0.10
RECOMMENDATION_DIVERSITY_WEIGHT=0.05

# Search Settings
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100
SEARCH_SIMILARITY_THRESHOLD=0.70

# Graph Settings
GRAPH_DEFAULT_LIMIT=25
GRAPH_MAX_LIMIT=50
GRAPH_SIMILARITY_THRESHOLD=0.70

# Application Configuration
APP_NAME=CiteConnect
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Project paths (relative to ModelPipeline root)
PROJECT_ROOT=.
BACKEND_PATH=./citeconnect-backend